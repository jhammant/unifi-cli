# Copy to .env and fill in. .env is gitignored.
# Real environment variables override anything set here.

# Gateway address (UDM / cloud key / controller host).
UNIFI_HOST=192.168.1.1

# SSH alias or host used for reads. Needs key-based access to the gateway.
UNIFI_SSH=udm

# Controller site id. Almost always "default", even when the display name isn't.
UNIFI_SITE=default

# Writes only. Must be a LOCAL admin — an SSO admin cannot authenticate an
# API call. UniFi → Settings → Admins & Users → Add Admin
#            → tick "Restrict to Local Access Only"
# Reads work fine with these left blank.
UNIFI_USER=
UNIFI_PASS=
